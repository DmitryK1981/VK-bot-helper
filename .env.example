# --- VK ---
# Токен сообщества (Управление → Работа с API → Ключи доступа). Права: сообщения сообщества.
# В настройках сообщества включите Long Poll API и события "Входящие сообщения",
# а также возможности ботов (для клавиатуры).
VK_TOKEN=vk1.a.xxxxx

# --- ProxyAPI.ru (Gemini) ---
PROXYAPI_KEY=sk-xxxxx
PROXYAPI_BASE_URL=https://api.proxyapi.ru
GEMINI_MODEL=gemini-3.1-flash-lite
# Резервная модель на случай сбоя основной (пусто = без резерва)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Бот ---
USERS_DIR=users
MAX_HISTORY_MESSAGES=100
MAX_DIALOGS_PER_USER=8
MAX_USER_MESSAGE_LENGTH=4000
LOG_LEVEL=INFO

# --- Лимиты и память ---
RATE_LIMIT_REQUESTS=8
RATE_LIMIT_WINDOW_SECONDS=60
SUMMARY_BATCH_SIZE=20
SUMMARY_MAX_CHARS=1500
STREAM_EDIT_INTERVAL=1.5
